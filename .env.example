# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite, local-first)
DATABASE_URL=sqlite:///./data/app.db

# Embeddings (baseline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranking (baseline)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM generation backend (Ollama-compatible, replaceable)
LLM_PROVIDER=ollama
LLM_MODEL=

# Vision-language model backend (replaceable)
VLM_PROVIDER=
VLM_MODEL=

# Ingestion (Phase 1)
DATA_DIR=./data
SUPPORTED_EXTENSIONS=pdf,docx,pptx,html,htm
MAX_UPLOAD_SIZE_MB=50
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Retrieval (Phase 2)
INDEX_DIR=./data/indexes
BM25_TOP_K=20
DENSE_TOP_K=20
EMBEDDING_BATCH_SIZE=32
RRF_K=60
RRF_CANDIDATE_K=20
RERANK_CANDIDATE_K=20
FINAL_TOP_K=5

# HyDE query expansion (Phase 2, off by default — see docs/architecture/retrieval.md)
HYDE_ENABLED=false
HYDE_MODEL=deepseek-r1:1.5b
OLLAMA_BASE_URL=http://localhost:11434
HYDE_MAX_TOKENS=256
HYDE_TEMPERATURE=0.2
HYDE_TIMEOUT_SECONDS=30.0
