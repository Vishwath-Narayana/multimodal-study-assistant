# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite, local-first)
DATABASE_URL=sqlite:///./data/app.db

# Embeddings (baseline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranking (baseline)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM generation backend (Ollama-compatible, replaceable)
LLM_PROVIDER=ollama
LLM_MODEL=

# Vision-language model backend (replaceable)
VLM_PROVIDER=
VLM_MODEL=
