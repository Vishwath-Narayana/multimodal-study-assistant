# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite, local-first)
DATABASE_URL=sqlite:///./data/app.db

# Embeddings (baseline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranking (baseline)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM generation backend (Ollama-compatible, replaceable) — Phase 3
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-r1:8b
GENERATION_MAX_TOKENS=512
GENERATION_TEMPERATURE=0.2
GENERATION_TIMEOUT_SECONDS=120.0

# Vision-language model backend (replaceable) — Phase 4. Empty = disabled
# (no VLM call ever attempted). Set to "ollama" + a multimodal model (e.g.
# "llava-phi3") to enable image/diagram description.
VLM_PROVIDER=
VLM_MODEL=
VLM_MAX_TOKENS=300
VLM_TIMEOUT_SECONDS=60.0

# OCR backend (Phase 4). Empty = disabled. Set to "tesseract" to enable
# (requires the system `tesseract` binary on PATH).
OCR_PROVIDER=

# Audio transcription backend (Phase 4). Empty = disabled — audio uploads
# fail explicitly rather than fabricating a transcript. Set to "whisper" to
# enable (faster-whisper; downloads model weights on first real use).
TRANSCRIPTION_PROVIDER=
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# Audio ingestion (Phase 4)
AUDIO_SUPPORTED_EXTENSIONS=wav,mp3,m4a
MAX_AUDIO_UPLOAD_SIZE_MB=200
TRANSCRIPT_CHUNK_TARGET_TOKENS=512

# Image-artifact validation (Phase 4)
MAX_IMAGE_ARTIFACT_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000

# Ingestion (Phase 1)
DATA_DIR=./data
SUPPORTED_EXTENSIONS=pdf,docx,pptx,html,htm
MAX_UPLOAD_SIZE_MB=50
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Retrieval (Phase 2)
INDEX_DIR=./data/indexes
BM25_TOP_K=20
DENSE_TOP_K=20
EMBEDDING_BATCH_SIZE=32
RRF_K=60
RRF_CANDIDATE_K=20
RERANK_CANDIDATE_K=20
FINAL_TOP_K=5

# HyDE query expansion (Phase 2, off by default — see docs/architecture/retrieval.md)
HYDE_ENABLED=false
HYDE_MODEL=deepseek-r1:1.5b
OLLAMA_BASE_URL=http://localhost:11434
HYDE_MAX_TOKENS=256
HYDE_TEMPERATURE=0.2
HYDE_TIMEOUT_SECONDS=30.0

# Evidence sufficiency / abstention (Phase 3 — see docs/architecture/generation.md)
SUFFICIENCY_MIN_CHUNKS=1
SUFFICIENCY_MIN_LEXICAL_OVERLAP=0.08
SUFFICIENCY_MIN_RERANKER_SCORE=0.0

# Deterministic chunk attribution (Phase 3, EduRAG baseline weighting)
ATTRIBUTION_RELEVANCE_WEIGHT=0.7
ATTRIBUTION_LEXICAL_WEIGHT=0.3

# Token grounding (Phase 3)
GROUNDING_THRESHOLD=0.8

# Contradiction checking (Phase 3)
CONTRADICTION_TOPIC_OVERLAP_THRESHOLD=0.2

# Study Engine (Phase 5). Reuses LLM_PROVIDER/LLM_MODEL/OLLAMA_BASE_URL
# above — no separate provider concept.
STUDY_MAX_TOKENS=1024
STUDY_TEMPERATURE=0.2
STUDY_TIMEOUT_SECONDS=120.0
STUDY_MIN_COUNT=1
STUDY_MAX_COUNT=20
